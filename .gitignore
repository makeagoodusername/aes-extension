.DS_Store
*.log
market-sample.html

# Local Playwright harness for live AFP testing — never part of the .crx
node_modules/
package-lock.json
audit/playwright/.profile/
audit/playwright/screenshots/
audit/playwright/traces/

# AS login credentials for the 8-Chrome audit runner. Real email/password
# never committed; the template at audit/credentials.json starts empty.
audit/credentials.json
audit/.pids/
audit/scripts/__pycache__/

# Local scratch fixtures — saved AS pages used for parser development.
# Stay on disk for the user's reference; never ship in the .crx.
USA Stations.html
created station after.html
html - for smaller countries without reigions.html
station alabama.html
aircraft.txt

# Browser-saved AS page captures — URL-flattened filenames with the
# `https-:` protocol prefix (e.g. `https-:free1.airlinesim.aero:app:com:scheduling:JFKATL?2694.html`
# plus the matching `_files/` companion dirs). Same purpose as the
# named fixtures above — kept on disk for parser development, never
# packaged in the .crx.
https-:*

# CLAUDE/ reference captures — plain-named browser saves of AS pages
# (e.g. CLAUDE/ACCOUNTING.html + CLAUDE/ACCOUNTING_files/) and the
# OLD REFERENCER subfolder. Tracked items under CLAUDE/ (handover-fragments
# at the time of writing) are unaffected; only generated captures match.
CLAUDE/*.html
CLAUDE/*_files/
CLAUDE/OLD REFERENCER/
CLAUDE/.DS_Store
