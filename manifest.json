{
    "manifest_version": 3,
    "name": "AirlineSim Enhancement Suite",
    "short_name": "AES",
    "description": "Great quality of live improvements for AirlineSim",
    "version": "0.6.9",
    "version_name": "0.6.9-beta",
    "author": "aes@hello.moiety.me",
    "homepage_url": "https://github.com/ZoeBijl/airlinesim-enhancement-suite/",
    "update_url": "https://github.com/ZoeBijl/airlinesim-enhancement-suite/releases",
    "action": {
        "default_icon": {
            "256": "images/AES-logo-256.png",
            "128": "images/AES-logo-128.png",
            "48": "images/AES-logo-48.png",
            "32": "images/AES-logo-32.png",
            "16": "images/AES-logo-16.png"
        }
    },
    "icons": {
        "256": "images/AES-logo-256.png",
        "128": "images/AES-logo-128.png",
        "48": "images/AES-logo-48.png",
        "32": "images/AES-logo-32.png",
        "16": "images/AES-logo-16.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "css": ["css/content.css"],
            "js": [
                "js/jquery-3.4.1.min.js",
                "helpers.js",
                "modules/aes-menu.js",
                "modules/about-dialog.js"
            ],
            "matches": ["https://*.airlinesim.aero/app/*", "https://*.airlinesim.aero/action/*"]
        },
        {
            "js": [
                "content_inventory.js",
                "modules/inventory/validation.js"
            ],
            "matches": ["https://*.airlinesim.aero/app/com/inventory/*"]
        },
        {
            "js": ["content_fligthSchedule.js"],
            "matches": ["https://*.airlinesim.aero/app/info/enterprises/*tab=3"]
        },
        {
            "js": ["content_settings.js"],
            "matches": ["https://*.airlinesim.aero/app/enterprise/settings*"]
        },
        {
            "js": [
                "modules/station-automation/storage.js",
                "modules/station-automation/country-scraper.js",
                "modules/used-aircraft-scanner/type-family-map.js",
                "modules/used-aircraft-scanner/scan-session-store.js",
                "modules/used-aircraft-scanner/presets-store.js",
                "modules/used-aircraft-scanner/deal-metrics.js",
                "modules/used-aircraft-scanner/results-table.js",
                "modules/used-aircraft-scanner/scan-controller.js",
                "modules/used-aircraft-scanner/family-grid-panel.js",
                "modules/schedule-management/range-buckets.js",
                "modules/schedule-management/presets-store.js",
                "modules/schedule-management/schedule-store.js",
                "modules/schedule-management/schedule-builder.js",
                "modules/schedule-management/schedule-panel.js",
                "modules/flightsfrom/data-store.js",
                "modules/flightsfrom/scan-controller.js",
                "modules/route-assistant/settings-store.js",
                "modules/route-assistant/fleet-store.js",
                "content_dashboard.js"
            ],
            "matches": ["https://*.airlinesim.aero/app/enterprise/dashboard*"]
        },
        {
            "js": [
                "modules/used-aircraft-scanner/type-family-map.js",
                "modules/used-aircraft-scanner/scan-session-store.js",
                "modules/aircraft-type-specs.js",
                "content_marketScan.js"
            ],
            "matches": ["https://*.airlinesim.aero/app/aircraft/market*"]
        },
        {
            "js": [
                "modules/flightsfrom/data-store.js",
                "content_flightsFrom.js"
            ],
            "matches": ["https://www.flightsfrom.com/*"]
        },
        {
            "js": [
                "modules/flightsfrom/data-store.js",
                "modules/flightsfrom/scan-controller.js",
                "modules/station-automation/country-scraper.js",
                "modules/aircraft-type-specs.js",
                "modules/route-assistant/demand-store.js",
                "modules/route-assistant/country-resolver.js",
                "modules/route-assistant/parallel-scanner.js",
                "modules/route-assistant/score.js",
                "modules/route-assistant/profit-estimator.js",
                "modules/route-assistant/aggregator.js",
                "modules/route-assistant/settings-store.js",
                "modules/route-assistant/distance-resolver.js",
                "modules/route-assistant/type-specs-store.js",
                "modules/route-assistant/fleet-store.js",
                "modules/route-assistant/route-overrides-store.js",
                "modules/route-assistant/route-note-store.js",
                "modules/route-assistant/fuel-price-scraper.js",
                "modules/route-assistant/fuel-burn-estimator.js",
                "modules/route-assistant/ticket-price-scraper.js",
                "modules/route-assistant/markets-page-scraper.js",
                "modules/route-assistant/inventory-page-scraper.js",
                "modules/route-assistant/demand-derivator.js",
                "modules/route-assistant/ors-scraper.js",
                "modules/route-assistant/yield-history-store.js",
                "modules/route-assistant/yield-snapshot.js",
                "modules/route-assistant/service-config-store.js",
                "modules/route-assistant/service-profile-scraper.js",
                "modules/route-assistant/carriers-scraper.js",
                "modules/route-assistant/enterprise-meta-scraper.js",
                "modules/route-assistant/contractual-partners-scraper.js",
                "modules/route-assistant/watchlist-store.js",
                "modules/schedule-management/range-buckets.js",
                "modules/schedule-management/schedule-store.js",
                "modules/schedule-management/presets-store.js",
                "modules/schedule-management/schedule-builder.js",
                "modules/route-assistant/wave-overlay.js",
                "modules/route-assistant/ors-model.js",
                "modules/route-assistant/toast-host.js",
                "modules/route-assistant/alert-rules-store.js",
                "modules/route-assistant/alert-evaluator.js",
                "modules/used-aircraft-scanner/presets-store.js",
                "modules/route-assistant/panel.js",
                "content_scheduling.js"
            ],
            "matches": ["https://*.airlinesim.aero/app/com/scheduling*"]
        },
        {
            "js": [
                "modules/route-assistant/markets-page-scraper.js",
                "content_markets.js"
            ],
            "matches": ["https://*.airlinesim.aero/app/com/markets/*"]
        },
        {
            "js": [
                "modules/station-automation/storage.js",
                "modules/station-automation/country-scraper.js",
                "content_stationOpen.js"
            ],
            "matches": [
                "https://*.airlinesim.aero/app/info/airports/*",
                "https://*.airlinesim.aero/app/ops/stations*"
            ]
        },
        {
            "js": ["content_personelManagement.js"],
            "matches": ["https://*.airlinesim.aero/action/enterprise/staffOverview*"]
        },
        {
            "js": ["content_enterpriceOverview.js"],
            "matches": ["https://*.airlinesim.aero/app/info/enterprises/*"]
        },
        {
            "js": [
                "content_flightInfo.js",
                "modules/data-models/flight-data.js"
            ],
            "matches": ["https://*.airlinesim.aero/action/info/flight*"]
        },
        {
            "js": [
                "content_aircraftFlights.js",
                "modules/aircraft-flights/aircraft-data.js",
                "modules/aircraft-flights/aircraft-statistics-panel.js",
                "modules/aircraft-flights/extraction-button.js",
                "modules/aircraft-flights/info-panel.js",
                "modules/data-models/flight-data.js"
            ],
            "matches": ["https://*.airlinesim.aero/app/fleets/aircraft/*/1*"]
        },
        {
            "js": ["content_fleetManagement.js"],
            "matches": ["https://*.airlinesim.aero/app/fleets*"]
        }
    ],
    "key": "",
    "permissions": ["activeTab", "declarativeContent", "storage", "unlimitedStorage"],
    "host_permissions": [
        "https://*.airlinesim.aero/*",
        "https://www.flightsfrom.com/*"
    ],
    "web_accessible_resources": [{
        "resources": ["/images/*"],
        "matches": ["https://*.airlinesim.aero/*"]
    }]
}
